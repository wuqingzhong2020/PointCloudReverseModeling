# UTF-8 声明文件；仅允许字面量 rm_module/rm_define 调用。
rm_module(name='project', summary='工程与任务交付')

rm_define(name='undo', summary='撤销上一步工程编辑', usage='project.undo', params=[],
    description='统一撤销点云编辑、模型重建/删除和已确认基准面，最多 10 步；新导入建立历史边界。',
    returns={'type': 'object', 'description': '恢复后的工程摘要；无历史返回错误'}, examples=['project.undo'])
rm_define(name='redo', summary='重做已撤销的工程编辑', usage='project.redo', params=[],
    description='恢复保存的几何结果；新工程编辑截断重做分支。',
    returns={'type': 'object', 'description': '恢复后的工程摘要；无历史返回错误'}, examples=['project.redo'])
rm_define(name='reset', summary='恢复最近一次导入状态', usage='project.reset', params=[],
    description='恢复已加载的完整点云或 STEP/CWRM 模型，可撤销此次重置；不重读源文件，不停止录制，不回滚导出文件。',
    returns={'type': 'object', 'description': '基线工程摘要；没有导入基线返回错误'}, examples=['project.reset'])

rm_define(
    name='snapshot',
    summary='查询当前工程摘要',
    usage='project.snapshot',
    params=[],
    returns={'type': 'object', 'description': '结果摘要；执行失败返回错误码'},
    examples=['project.snapshot', 'snapshot = rm.execute("project.snapshot")'],
)


rm_define(
    name='set_output_dir',
    summary='设置本次任务输出目录',
    usage='project.set_output_dir <path>',
    params=[{'name': 'path', 'binding': 'positional', 'position': 1,
             'type': 'path', 'required': True, 'min_size': 1,
             'description': '交付目录；同目录重复设置不重置结果，不允许切换到其他目录'}],
    returns={'type': 'object', 'description': '输出目录；初始化 result.json 为失败状态'},
    examples=['project.set_output_dir "D:/任务/001"'],
)

rm_define(
    name='export_and_exit',
    summary='导出完整模型、提交结果并退出',
    usage='project.export_and_exit',
    params=[],
    returns={'type': 'object', 'description': 'STEP 和结果 JSON；成功保存录制后退出并停止脚本后续内容'},
    examples=['project.export_and_exit'],
)

rm_define(
    name='set_reference_plane', summary='用三个工程坐标点设置基准面',
    usage='project.set_reference_plane --points <[[x,y,z],[x,y,z],[x,y,z]]>',
    description='三个非共线点，单位 mm；点序决定法线方向。用于正视和点云剖视，不变换原始坐标或重建几何。重新定面会关闭剖视。',
    params=[{'name': 'points', 'binding': 'option', 'option': '--points', 'type': 'array',
             'required': True, 'min_size': 3, 'max_size': 3,
             'items': {'type': 'array', 'min_size': 3, 'max_size': 3, 'items': {'type': 'float'}},
             'description': '三个工程坐标 XYZ（mm），不是显示局部坐标'}],
    returns={'type': 'object', 'description': '包含基准面的工程摘要'},
    examples=['project.set_reference_plane --points "[[0,0,0],[100,0,0],[0,100,0]]"'],
)

rm_define(
    name='clear_reference_plane', summary='清除基准面并关闭点云剖视',
    usage='project.clear_reference_plane', params=[],
    returns={'type': 'object', 'description': '工程摘要'}, examples=['project.clear_reference_plane'],
)

rm_define(
    name='section', summary='按底板面或基准面设置点云剖视',
    usage='project.section --enabled true|false [--plane bottom|reference] [--offset <mm>] [--reverse true|false]',
    description='仅过滤点云显示，不删除点云，不影响框选、重建或导出。偏移沿原法线；默认保留正法线侧，reverse 仅反转保留侧。',
    params=[{'name': 'enabled', 'binding': 'option', 'option': '--enabled', 'type': 'bool', 'required': True},
            {'name': 'offset', 'binding': 'option', 'option': '--offset', 'type': 'float', 'default': 0.0,
             'description': '沿所选剖视面法线的偏移，单位 mm'},
            {'name': 'reverse', 'binding': 'option', 'option': '--reverse', 'type': 'bool', 'default': False,
             'description': '反转点云保留侧'},
            {'name': 'plane', 'binding': 'option', 'option': '--plane', 'type': 'enum',
             'values': ['bottom', 'reference'], 'default': 'reference',
             'description': 'bottom：识别底板面；reference：已确认的自定义基准面'}],
    returns={'type': 'object', 'description': '包含剖视状态的工程摘要'},
    examples=['project.section --enabled true --offset 10 --reverse false', 'project.section --enabled false'],
)
