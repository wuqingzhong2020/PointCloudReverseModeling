# UTF-8 声明文件；仅允许字面量 rm_module/rm_define 调用。
rm_module(name='project', summary='工程与任务交付')

rm_define(
    name='snapshot',
    summary='查询当前工程摘要',
    usage='project.snapshot',
    params=[],
    returns={'type': 'object', 'description': '结果摘要；执行失败返回错误码'},
    examples=['project.snapshot', 'snapshot = rm.execute("project.snapshot")'],
)


rm_define(
    name='set_output_dir',
    summary='设置本次任务输出目录',
    usage='project.set_output_dir <path>',
    params=[{'name': 'path', 'binding': 'positional', 'position': 1,
             'type': 'path', 'required': True, 'min_size': 1,
             'description': '交付目录；同目录重复设置不重置结果，不允许切换到其他目录'}],
    returns={'type': 'object', 'description': '输出目录；初始化 result.json 为失败状态'},
    examples=['project.set_output_dir "D:/任务/001"'],
)

rm_define(
    name='export_and_exit',
    summary='导出完整模型、提交结果并退出',
    usage='project.export_and_exit',
    params=[],
    returns={'type': 'object', 'description': 'STEP 和结果 JSON；成功保存录制后退出并停止脚本后续内容'},
    examples=['project.export_and_exit'],
)
