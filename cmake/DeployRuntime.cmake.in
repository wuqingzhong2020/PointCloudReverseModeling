# 文件描述：在构建后、手动补部署或安装阶段复用的 Windows 运行文件部署。
cmake_minimum_required(VERSION 3.25)
set(RM_EXE [==[@RM_EXECUTABLE@]==])
set(RM_NAME [==[@RM_DEPLOY_TARGET@]==])
set(RM_SEARCH [==[@RM_DLL_DIRS@]==])
set(RM_CRT [==[@RM_CRT_DLLS@]==])
set(RM_PREFIXES [==[@CMAKE_PREFIX_PATH@]==])
set(RM_RESOURCE [==[@RM_OCCT_RESOURCE_DIR@]==])
set(RM_QT @RM_DEPLOY_QT@)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND [==[@DUMPBIN_EXECUTABLE@]==])
if(NOT EXISTS "${RM_EXE}")
    message(FATAL_ERROR "Missing executable: ${RM_EXE}. Compile first.")
endif()
if(NOT DEFINED RM_DEST)
    get_filename_component(RM_DEST "${RM_EXE}" DIRECTORY)
endif()
get_filename_component(RM_DEST "${RM_DEST}" ABSOLUTE)
set(_ancestor "${RM_DEST}")
while(TRUE)
    if(IS_SYMLINK "${_ancestor}")
        message(FATAL_ERROR "Runtime destination traverses a link: ${_ancestor}")
    endif()
    get_filename_component(_parent "${_ancestor}" DIRECTORY)
    if(_parent STREQUAL _ancestor)
        break()
    endif()
    set(_ancestor "${_parent}")
endwhile()
file(MAKE_DIRECTORY "${RM_DEST}")
file(LOCK "${RM_DEST}/.runtime-deploy.lock" GUARD PROCESS TIMEOUT 120)
function(rm_checked_child relative output)
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)|:" OR relative STREQUAL ".")
        message(FATAL_ERROR "Unsafe runtime manifest path: ${relative}")
    endif()
    get_filename_component(_candidate "${RM_DEST}/${relative}" ABSOLUTE)
    set(_ancestor "${_candidate}")
    while(NOT _ancestor STREQUAL RM_DEST)
        if(IS_SYMLINK "${_ancestor}")
            message(FATAL_ERROR "Runtime path traverses a link: ${_ancestor}")
        endif()
        get_filename_component(_parent "${_ancestor}" DIRECTORY)
        if(_parent STREQUAL _ancestor)
            message(FATAL_ERROR "Runtime path escapes destination: ${relative}")
        endif()
        set(_ancestor "${_parent}")
    endwhile()
    set(${output} "${_candidate}" PARENT_SCOPE)
endfunction()
set(RM_MANIFEST "${RM_DEST}/.runtime-${RM_NAME}.json")
file(SHA256 "${RM_EXE}" RM_EXE_HASH)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" RM_SCRIPT_HASH)
# SDK 文件增删或更新时间变化也触发补部署，避免仅检查 EXE 后误用旧依赖。
set(_input_files ${RM_CRT})
foreach(_dir IN LISTS RM_SEARCH)
    if(IS_DIRECTORY "${_dir}")
        file(GLOB _dlls "${_dir}/*.dll")
        list(APPEND _input_files ${_dlls})
    endif()
endforeach()
if(RM_QT)
    list(APPEND _input_files [==[@RM_QT_DEPLOY_SCRIPT@]==])
    file(GLOB_RECURSE _resources LIST_DIRECTORIES FALSE "${RM_RESOURCE}/*")
    list(APPEND _input_files ${_resources})
endif()
list(FILTER _input_files EXCLUDE REGEX "^$")
list(REMOVE_DUPLICATES _input_files)
list(SORT _input_files)
set(_input_data "")
foreach(_input IN LISTS _input_files)
    if(EXISTS "${_input}")
        file(SIZE "${_input}" _size)
        file(TIMESTAMP "${_input}" _time "%Y-%m-%dT%H:%M:%S.%f" UTC)
        string(APPEND _input_data "${_input}|${_size}|${_time}\n")
    endif()
endforeach()
string(SHA256 RM_INPUT_HASH "${_input_data}")
set(RM_VALID FALSE)
if(EXISTS "${RM_MANIFEST}")
    file(READ "${RM_MANIFEST}" RM_OLD)
    string(JSON _exe ERROR_VARIABLE _err GET "${RM_OLD}" executable_sha256)
    string(JSON _script ERROR_VARIABLE _err GET "${RM_OLD}" script_sha256)
    string(JSON _inputs ERROR_VARIABLE _err GET "${RM_OLD}" input_signature)
    if(_exe STREQUAL RM_EXE_HASH AND _script STREQUAL RM_SCRIPT_HASH AND _inputs STREQUAL RM_INPUT_HASH)
        set(RM_VALID TRUE)
        string(JSON _count LENGTH "${RM_OLD}" files)
        if(_count GREATER 0)
            math(EXPR _last "${_count}-1")
            foreach(_i RANGE 0 ${_last})
                string(JSON _path GET "${RM_OLD}" files ${_i} path)
                rm_checked_child("${_path}" _checked)
                string(JSON _expected GET "${RM_OLD}" files ${_i} sha256)
                if(NOT EXISTS "${RM_DEST}/${_path}")
                    set(RM_VALID FALSE)
                    break()
                endif()
                file(SHA256 "${RM_DEST}/${_path}" _actual)
                if(NOT _actual STREQUAL _expected)
                    set(RM_VALID FALSE)
                    break()
                endif()
            endforeach()
        endif()
    endif()
endif()
# 手动补部署始终重新扫描 SDK；自动部署只在清单验证成功时跳过。
if(RM_VALID AND NOT RM_FORCE)
    message(STATUS "${RM_NAME} runtime ready ($<CONFIG>)")
    return()
endif()

set(RM_STAGE "${RM_DEST}/.runtime-stage-${RM_NAME}")
if(IS_SYMLINK "${RM_STAGE}")
    message(FATAL_ERROR "Runtime staging directory must not be a link")
endif()
file(GLOB_RECURSE _stale_stage LIST_DIRECTORIES TRUE "${RM_STAGE}/*")
foreach(_path IN LISTS _stale_stage)
    if(IS_SYMLINK "${_path}")
        message(FATAL_ERROR "Runtime staging directory contains a link: ${_path}")
    endif()
endforeach()
file(REMOVE_RECURSE "${RM_STAGE}")
file(MAKE_DIRECTORY "${RM_STAGE}")
file(MAKE_DIRECTORY "${RM_STAGE}/scan")
get_filename_component(_exe_name "${RM_EXE}" NAME)
file(COPY_FILE "${RM_EXE}" "${RM_STAGE}/scan/${_exe_name}")
set(RM_SCAN_EXE "${RM_STAGE}/scan/${_exe_name}")
list(FILTER RM_SEARCH EXCLUDE REGEX "^$")
list(REMOVE_DUPLICATES RM_SEARCH)
list(JOIN RM_SEARCH ";" _sdk_path)
get_filename_component(_dumpbin_dir "${CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND}" DIRECTORY)
set(ENV{PATH} "${_sdk_path};${_dumpbin_dir};$ENV{PATH}")

function(rm_scan)
    file(GET_RUNTIME_DEPENDENCIES
        EXECUTABLES "${RM_SCAN_EXE}" MODULES ${ARGN}
        DIRECTORIES ${RM_SEARCH}
        RESOLVED_DEPENDENCIES_VAR _resolved
        UNRESOLVED_DEPENDENCIES_VAR _missing
        CONFLICTING_DEPENDENCIES_PREFIX _conflict
        PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-"
        POST_EXCLUDE_REGEXES ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*")
    if(_missing)
        message(FATAL_ERROR "Unresolved DLLs: ${_missing}")
    endif()
    foreach(_name IN LISTS _conflict_FILENAMES)
        set(_paths "${_conflict_${_name}}")
        list(GET _paths 0 _first)
        file(SHA256 "${_first}" _first_hash)
        set(_qt_staged FALSE)
        foreach(_path IN LISTS _paths)
            if(_name MATCHES "^Qt6" AND _path MATCHES "[.]runtime-stage-")
                set(_qt_staged TRUE)
            endif()
        endforeach()
        foreach(_path IN LISTS _paths)
            file(SHA256 "${_path}" _hash)
            if(NOT _hash STREQUAL _first_hash AND NOT _qt_staged)
                message(FATAL_ERROR "Conflicting DLL ${_name}: ${_paths}")
            endif()
        endforeach()
        list(APPEND _resolved "${_first}")
    endforeach()
    foreach(_dll IN LISTS _resolved)
        get_filename_component(_name "${_dll}" NAME)
        # 已经由 Qt 部署到插件子目录的文件不再复制到根目录。
        file(RELATIVE_PATH _relative "${RM_STAGE}" "${_dll}")
        if(NOT _relative MATCHES "^\\.\\.")
            continue()
        endif()
        if(EXISTS "${RM_STAGE}/${_name}")
            file(SHA256 "${_dll}" _source_hash)
            file(SHA256 "${RM_STAGE}/${_name}" _dest_hash)
            # QtCore 会被 windeployqt 修正路径，不能用该差异判断版本冲突。
            if(NOT _source_hash STREQUAL _dest_hash AND NOT _name MATCHES "^Qt6")
                message(FATAL_ERROR "Conflicting runtime DLL: ${_name}")
            endif()
        else()
            file(COPY_FILE "${_dll}" "${RM_STAGE}/${_name}" ONLY_IF_DIFFERENT)
        endif()
    endforeach()
endfunction()

rm_scan()
foreach(_dll IN LISTS RM_CRT)
    if(EXISTS "${_dll}")
        get_filename_component(_name "${_dll}" NAME)
        file(COPY_FILE "${_dll}" "${RM_STAGE}/${_name}" ONLY_IF_DIFFERENT)
    endif()
endforeach()
if(RM_QT)
    include([==[@RM_QT_DEPLOY_SCRIPT@]==])
    file(GLOB_RECURSE _plugins "${RM_STAGE}/*.dll")
    rm_scan(${_plugins})
    if(NOT EXISTS "${RM_STAGE}/platforms/qwindows$<$<CONFIG:Debug>:d>.dll")
        message(FATAL_ERROR "Qt Windows platform plugin was not deployed")
    endif()
    if(NOT IS_DIRECTORY "${RM_RESOURCE}/Shaders")
        message(FATAL_ERROR "Missing OCCT Shaders: ${RM_RESOURCE}")
    endif()
    foreach(_resource IN ITEMS Shaders SHMessage StdResource UnitsAPI XSMessage XSTEPResource)
        if(IS_DIRECTORY "${RM_RESOURCE}/${_resource}")
            file(COPY "${RM_RESOURCE}/${_resource}" DESTINATION "${RM_STAGE}/resources/opencascade")
        endif()
    endforeach()
endif()
file(REMOVE_RECURSE "${RM_STAGE}/scan")
# SDK 许可集合随运行包保留；不把整个 SDK 的二进制或开发文件复制进来。
foreach(_prefix IN LISTS RM_PREFIXES)
    file(GLOB _copyrights "${_prefix}/share/*/copyright")
    foreach(_copyright IN LISTS _copyrights)
        get_filename_component(_port_dir "${_copyright}" DIRECTORY)
        get_filename_component(_port "${_port_dir}" NAME)
        file(MAKE_DIRECTORY "${RM_STAGE}/licenses/${_port}")
        file(COPY_FILE "${_copyright}" "${RM_STAGE}/licenses/${_port}/copyright" ONLY_IF_DIFFERENT)
    endforeach()
endforeach()

file(GLOB_RECURSE RM_FILES RELATIVE "${RM_STAGE}" LIST_DIRECTORIES FALSE "${RM_STAGE}/*")
list(SORT RM_FILES)
set(RM_OWNED "")
set(RM_OTHER_OWNED "")
file(GLOB _manifests "${RM_DEST}/.runtime-*.json")
foreach(_manifest IN LISTS _manifests)
    file(READ "${_manifest}" _content)
    string(JSON _count ERROR_VARIABLE _error LENGTH "${_content}" files)
    if(NOT _error AND _count GREATER 0)
        math(EXPR _last "${_count}-1")
        foreach(_i RANGE 0 ${_last})
            string(JSON _path GET "${_content}" files ${_i} path)
            rm_checked_child("${_path}" _checked)
            list(APPEND RM_OWNED "${_path}")
            if(NOT _manifest STREQUAL RM_MANIFEST)
                list(APPEND RM_OTHER_OWNED "${_path}")
            endif()
        endforeach()
    endif()
endforeach()
# 全部路径和未登记冲突在写入前检查，避免覆盖用户放在产物目录的文件。
foreach(_path IN LISTS RM_FILES)
    rm_checked_child("${_path}" _checked)
    if(EXISTS "${_checked}" AND NOT _path IN_LIST RM_OWNED)
        file(SHA256 "${_checked}" _existing)
        file(SHA256 "${RM_STAGE}/${_path}" _planned)
        if(NOT _existing STREQUAL _planned)
            message(FATAL_ERROR "Unmanaged runtime file conflicts with deployment: ${_checked}")
        endif()
    endif()
endforeach()
set(RM_JSON_FILES "")
foreach(_path IN LISTS RM_FILES)
    if(IS_SYMLINK "${RM_DEST}/${_path}")
        message(FATAL_ERROR "Refusing to replace runtime link: ${_path}")
    endif()
    get_filename_component(_parent "${RM_DEST}/${_path}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    file(COPY_FILE "${RM_STAGE}/${_path}" "${RM_DEST}/${_path}" ONLY_IF_DIFFERENT)
    file(SHA256 "${RM_DEST}/${_path}" _hash)
    if(RM_JSON_FILES)
        string(APPEND RM_JSON_FILES ",\n")
    endif()
    string(APPEND RM_JSON_FILES "    {\"path\": \"${_path}\", \"sha256\": \"${_hash}\"}")
endforeach()
# 只移除上一份清单中已登记、且未被用户修改的过期文件。
if(DEFINED RM_OLD)
    string(JSON _count ERROR_VARIABLE _error LENGTH "${RM_OLD}" files)
    if(NOT _error AND _count GREATER 0)
        math(EXPR _last "${_count}-1")
        foreach(_i RANGE 0 ${_last})
            string(JSON _path GET "${RM_OLD}" files ${_i} path)
            string(JSON _expected GET "${RM_OLD}" files ${_i} sha256)
            if(_path IN_LIST RM_FILES OR _path IN_LIST RM_OTHER_OWNED OR _path MATCHES "(^|/)\\.\\.(/|$)|:|^[/\\\\]")
                continue()
            endif()
            rm_checked_child("${_path}" _checked)
            if(EXISTS "${RM_DEST}/${_path}" AND NOT IS_SYMLINK "${RM_DEST}/${_path}")
                file(SHA256 "${RM_DEST}/${_path}" _actual)
                if(_actual STREQUAL _expected)
                    file(REMOVE "${RM_DEST}/${_path}")
                endif()
            endif()
        endforeach()
    endif()
endif()
file(WRITE "${RM_MANIFEST}.tmp"
    "{\n  \"schema\": 1,\n  \"configuration\": \"$<CONFIG>\",\n  \"executable_sha256\": \"${RM_EXE_HASH}\",\n  \"script_sha256\": \"${RM_SCRIPT_HASH}\",\n  \"input_signature\": \"${RM_INPUT_HASH}\",\n  \"files\": [\n${RM_JSON_FILES}\n  ]\n}\n")
file(RENAME "${RM_MANIFEST}.tmp" "${RM_MANIFEST}")
file(REMOVE_RECURSE "${RM_STAGE}")
message(STATUS "Deployed ${RM_NAME} runtime to ${RM_DEST}")
