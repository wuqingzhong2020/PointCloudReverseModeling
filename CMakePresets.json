{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": {
          "type": "PATH",
          "value": "D:/projectWQZ/LibPackByVcpkgWindows/install_vc143_cpp20/x64-windows-v143-cpp20"
        }
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vc143-cpp20",
      "displayName": "Windows / Qt desktop + Google Test / MSVC v143 / C++20",
      "inherits": "windows-base"
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "vc143-cpp20", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-release", "configurePreset": "vc143-cpp20", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
